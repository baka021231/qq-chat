{
  "ws_url": "ws://127.0.0.1:3001",
  "onebot_token": "<NapCat OneBot token>",
  "codex_path": "/home/<user>/.local/bin/codex",
  "owner_qq": "<主人 QQ>",
  "private_whitelist": [],
  "allow_all_groups": true,
  "allowed_groups": [],
  "group_user_blacklist": [],
  "mention_qq": [],
  "show_tool_progress": false,
  "voice": {
    "enabled": false,
    "timeout_seconds": 120,
    "command": [
      "/home/<user>/.local/share/aemeath-voice/venv/bin/python",
      "-u",
      "/path/to/qq-chat/tools/voice_backend.py",
      "--model-dir",
      "/home/<user>/.local/share/aemeath-voice/model/ONNX_aimisiV2"
    ]
  },
  "agents": {
    "front": "claude_front",
    "guest": "claude_guest",
    "back": [
      "codex"
    ],
    "profiles": {
      "claude_front": {
        "type": "claude_code",
        "path": "/home/<user>/.local/bin/claude",
        "model": "sonnet",
        "models": [
          "sonnet"
        ],
        "permission_mode": "dontAsk",
        "max_turns": 6
      },
      "claude_guest": {
        "type": "claude_code",
        "path": "/home/<user>/.local/bin/claude",
        "model": "haiku",
        "models": [
          "haiku"
        ],
        "max_turns": 6
      },
      "codex": {
        "type": "codex_app",
        "sandbox": "danger-full-access",
        "writes": true,
        "max_parallel": 1
      }
    }
  },
  "tasks": {
    "max_running": 4,
    "max_writers": 1,
    "max_per_conversation": 3,
    "timeout_minutes": 60,
    "progress": "direct",
    "report_chars": 4000
  }
}
